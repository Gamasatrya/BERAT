rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Content sections, testimonials, FAQs: Read public, Write authenticated
    match /content/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media metadata: Read public, Write authenticated
    match /media_metadata/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Articles: Read published for public, Read/Write all for authenticated
    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Contact Submissions: Create public, Read/Update/Delete authenticated
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Site settings: Read public, Write authenticated
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
